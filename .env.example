# Backend
SECRET_KEY="generate-a-fresh-secret-key"
DEBUG="False"
ALLOWED_HOSTS="localhost,127.0.0.1,backend"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Only enable once TLS is in front of the app (see README "Deployment (AWS)").
# Leaving these False breaks the site on plain HTTP (redirect loops / rejected
# cookies), so they default off until a domain + certificate exist.
SECURE_SSL_REDIRECT="False"
SESSION_COOKIE_SECURE="False"
CSRF_COOKIE_SECURE="False"
SECURE_HSTS_SECONDS="0"

# Frontend
# Used by `docker compose up` (local dev) only. The production compose file
# (docker-compose.prod.yml) hardcodes the frontend's build-time API URL to
# the internal Docker network address instead of reading this var.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Postgres
# POSTGRES_* and this local-style DATABASE_URL are for `docker-compose.yml`
# (local dev, `db` service) only. In production, DATABASE_URL points at RDS
# instead and POSTGRES_* are unused.
DATABASE_URL="postgresql://postgres:postgres@db:5432/portfolio_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="portfolio_db"
